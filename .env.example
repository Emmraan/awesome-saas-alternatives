# Copy this file to `.env.local` (or `.env`) and fill in real values.
# `.env*.local` and `.env` are gitignored — never commit secrets.

# Public site URL — used for canonical URLs, sitemap, robots.txt, llms.txt and OG tags.
# Required for `next build` (sitemap.ts hard-errors without it). On Vercel this is
# set automatically as `NEXT_PUBLIC_SITE_URL`; for local builds set it explicitly.
NEXT_PUBLIC_SITE_URL=https://awesome-saas-alternatives.vercel.app

# GitHub personal access token — used by `pnpm sync:github` to fetch stars/forks/
# license/release metadata into `data/products.json` (see `scripts/sync-github.ts`).
# Optional but strongly recommended: unauthenticated requests are limited to 60
# requests/hour, while a token allows 5000/hour. Scope: public repo read only.
# Create one at https://github.com/settings/tokens — no scopes are required.
GITHUB_TOKEN=